{
  "name": "nate-the-plot",
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon --ignore client/ --exec tsx server/index.ts",
    "client": "npm --prefix client run dev",
    
    "postinstall": "npm install --prefix client && npm install --prefix server",
    "build": "npm --prefix client run build && tsc --project server/tsconfig.json",
    "start": "node server/dist/index.js"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "concurrently": "^8.2.0",
    "nodemon": "^3.0.2",
    "tsx": "^4.21.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "react-select": "^5.10.2",
    "typescript": "^6.0.3"
  }
}
