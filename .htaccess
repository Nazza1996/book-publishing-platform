RewriteEngine On

# Redirect /index or /index.html → /
RewriteCond %{THE_REQUEST} \s/index(\.html)?[\s?] [NC]
RewriteRule ^index(\.html)?$ / [R=301,L]

# Redirect .html → clean URL
RewriteCond %{THE_REQUEST} \s(.+?)\.html[\s?] [NC]
RewriteRule ^ %1 [R=301,L]

# Only rewrite if the .html file exists
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

# Redirect .php → clean URL (skip requests under /php/)
RewriteCond %{REQUEST_URI} !^/php/
RewriteCond %{THE_REQUEST} \s(.+?)\.php[\s?] [NC]
RewriteRule ^ %1 [R=301,L]

# Only rewrite to a .php file if the .php exists (skip /php/ folder)
RewriteCond %{REQUEST_URI} !^/php/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L]

# Deny direct web access to sensitive php files placed in /php
<IfModule mod_authz_core.c>
	<FilesMatch "^(db|auth)\.php$">
		Require all denied
	</FilesMatch>
</IfModule>

ErrorDocument 404 /404.html
ErrorDocument 403 /404.html